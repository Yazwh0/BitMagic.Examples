{
    "source": "",
    "directRun": false,
    "autobootRun": true,
    "autobootFile": "DT.PRG",
    "sdCard": "dreamtracker.base.bin.gz",
    "sdCardFiles": [
        {
            "source": "dream-tracker/SAMPLES",
            "dest": "SAMPLES"
        },
        {
            "source": "dream-tracker/SCR",
            "dest": "SCR"
        },
        {
            "source": "dream-tracker/SONGS",
            "dest": "SONGS"
        }
    ],
    "sdCardOutput": "dreamtracker.bin.gz",
    "sdCardFinalOutput": "dreamtracker.final.bin.gz",
    "files": [
        {
            "type": "cc65",
            "outputs": [
                {
                    "filename": "DT.PRG",
                    "default": true,
                    "hasHeader": true
                },
                {
                    "filename": "DAT/*",
                    "hasHeader": false
                }
            ],
            "debugFile": "../dreamtracker.dbg",
            "basePath": "dream-tracker"
        }
    ]
}
