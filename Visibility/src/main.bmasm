import BM="bm.bmasm";
import Text="text.bmasm";

BM.X16Header();

; main only uses what the text library makes public: its print procedure, and the
; names it exports. Everything else in the library is kept to itself.
.proc main
    ; version is an expression the library exports, built from names it keeps private
    lda #'V'
    jsr BSOUT
    lda #>text:version          ; the major version
    clc
    adc #'0'
    jsr BSOUT
    lda #'.'
    jsr BSOUT
    lda #<text:version          ; the minor version
    clc
    adc #'0'
    jsr BSOUT
    lda #13
    jsr BSOUT                   ; V1.2

    ldx #<hello
    ldy #>hello
    jsr text:print              ; HELLO FROM MAIN

    ; string is the operand of the lda that reads the text, deep inside print, so it
    ; still points at hello. Step it on past "HELLO " and print the rest.
    clc
    lda text:string
    adc #6
    sta text:string
    lda text:string + 1         ; string is a ushort, so + 1 is its high byte
    adc #0
    sta text:string + 1
    jsr text:reprint            ; FROM MAIN

    ; or point it somewhere new, without going through X and Y
    lda #<poked
    sta text:string
    lda #>poked
    sta text:string + 1
    jsr text:reprint            ; WRITTEN STRAIGHT INTO THE LDA

    ; lines is private, but the library exports it as line_count
    lda text:line_count         ; 3
    clc
    adc #'0'
    jsr BSOUT                   ; prints 3

    ; Each of these is private to the text library, so would stop the build:
    ;jsr text:newline           ; a private procedure
    ;lda #text:RETURN           ; a private constant
    ;lda text:lines             ; a private variable
    ;jsr text:print:write       ; a private procedure, inside print
    ;lda text:print:write:source ; a label, inside that private procedure

.wait:
    jmp wait

.hello:
    BM.Bytes(BM.StringToPetscii("HELLO FROM MAIN"));
.poked:
    BM.Bytes(BM.StringToPetscii("WRITTEN STRAIGHT INTO THE LDA"));
.endproc
